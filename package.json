{
	"name": "personal-site-2",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"deploy": "yarn build && echo 'kolcrooks.com' > build/CNAME && yarn gh-pages -d build -t"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"mdsvex": "^0.12.8",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.0",
		"vite": "^8.3.3"
	},
	"dependencies": {
		"@dimforge/rapier3d-compat": "^0.21.0",
		"@sparkjsdev/spark": "^2.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@threlte/core": "^8.6.1",
		"@threlte/extras": "^9.22.0",
		"@threlte/rapier": "^3.5.1",
		"@types/three": "^0.186.0",
		"gh-pages": "^6.3.0",
		"tailwindcss": "^4.3.3",
		"three": "^0.186.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
